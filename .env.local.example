# ============================================================
# Roam — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — find these in your project dashboard under Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — server-side only (never browser). Used by the
# admin client (guest sharing on trip settings, Stripe webhook) and by
# migration scripts. Without it, the share-guests section is hidden.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mapbox — find this in your Mapbox account under Access Tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# Google Places — used by the /api/places/* routes (autocomplete, details,
# photos, bulk import / enrichment)
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Unsplash — find this in your Unsplash developer dashboard under Applications
# Server-side key fetches destination cover photos; the NEXT_PUBLIC_ key is
# used in the browser (board background picker, new-trip page)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Site URL — the app's public origin, used for share links and auth redirects
# (http://localhost:3000 for local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — server-side only. Secret key for the checkout flow; webhook secret
# verifies signatures on /api/stripe/webhook
STRIPE_SECRET_KEY=sk_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# Anthropic — used server-side only (confirmation parsing + the AI companion)
# Never exposed to the browser; do not prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Migration helper — your Supabase user UUID (after first login)
# Run: supabase auth list  OR  check the users table in your dashboard
SEED_USER_ID=your-user-uuid-here
